# Public production origin used for canonical URLs and sitemap entries.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Private server-side AI configuration. Never prefix these with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_AGENT_ENABLED=true

# Optional legacy provider credentials. Gemini is not used by the production
# chat route unless explicitly wired in for future provider work.
GEMINI_API_KEY=
GEMINI_MODEL=

# Private Google Sheets lead storage. Share the target sheet with the service
# account email, then create a tab named Leads with the documented 15 columns.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Use the service-account PEM value. A single-line value containing \n is supported.
GOOGLE_PRIVATE_KEY=
